<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vacations"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <EditText
        android:id="@+id/searchVacationEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search vacations"
        android:inputType="text"
        android:singleLine="true"
        android:padding="10dp" />

    <ListView
        android:id="@+id/vacationListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/addVacationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Vacation" />

    <Button
        android:id="@+id/backupToCloudButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back Up to Cloud"
        android:layout_marginTop="8dp" />

</LinearLayout>